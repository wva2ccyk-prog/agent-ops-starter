{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/docs_hook.py\" --extra \"$CLAUDE_PROJECT_DIR/CLAUDE.md\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
